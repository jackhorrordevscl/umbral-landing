---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Umbral: Fichas clínicas para terapeutas independientes",
  description = "Umbral es la ficha clínica para terapeutas que atienden por su cuenta: agenda, cobro en línea y recordatorios. Acceso anticipado por invitación.",
  noindex = false,
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);
const ogAlt = "Umbral: ficha clínica para terapeutas que atienden por su cuenta";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": new URL("/#org", Astro.site).href,
      name: "Ground Zero Devs",
      url: "https://groundzerodevs.com",
    },
    {
      "@type": "WebSite",
      "@id": new URL("/#site", Astro.site).href,
      name: "Umbral",
      url: new URL("/", Astro.site).href,
      inLanguage: "es-CL",
      publisher: { "@id": new URL("/#org", Astro.site).href },
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf8f0" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1e" media="(prefers-color-scheme: dark)" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
    <title>{title}</title>

    <!-- the two faces above the fold are fetched with the HTML, not after the CSS -->
    <link rel="preload" href="/fonts/dm-serif-display.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={pageUrl} />}
    <meta property="og:site_name" content="Umbral" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      // runs before first paint to avoid a light/dark flash
      let stored = null;
      try {
        // storage can throw (blocked cookies, sandboxed frames): fall back to the OS preference
        stored = localStorage.getItem("umbral-theme");
      } catch {
        stored = null;
      }
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-sage-600 focus:px-4 focus:py-2 focus:font-sans focus:text-sm focus:font-medium focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      // builds mailto hrefs at runtime so the plain address never sits in the HTML source.
      // Links marked data-mailto-show also swap their spelled-out fallback for the real address.
      document.querySelectorAll("[data-mailto-user]").forEach((el) => {
        const user = el.getAttribute("data-mailto-user");
        const domain = el.getAttribute("data-mailto-domain");
        if (!user || !domain) return;
        el.setAttribute("href", `mailto:${user}@${domain}`);
        if (el.hasAttribute("data-mailto-show")) el.textContent = `${user}@${domain}`;
      });
    </script>
  </body>
</html>
