---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Umbral — Fichas clínicas para terapeutas independientes",
  description = "Umbral es el sistema de fichas clínicas de quien atiende por su cuenta: MFA obligatorio, consentimiento granular, auditoría inmutable y cumplimiento de las leyes 20.584, 19.628 y 21.719.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // runs before first paint to avoid a light/dark flash
      const stored = localStorage.getItem("umbral-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
