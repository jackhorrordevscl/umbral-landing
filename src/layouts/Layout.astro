---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Umbral — Fichas clínicas para terapeutas independientes",
  description = "Umbral es el sistema de fichas clínicas de quien atiende por su cuenta: MFA obligatorio, consentimiento granular, auditoría inmutable y cumplimiento de las leyes 20.584, 19.628 y 21.719.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL("/og-image.png", Astro.site)} />
    <meta property="og:locale" content="es_CL" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.site)} />


    <script is:inline>
      // runs before first paint to avoid a light/dark flash
      const stored = localStorage.getItem("umbral-theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (stored === "dark" || (!stored && prefersDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>
  <body class="antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-sage-600 focus:px-4 focus:py-2 focus:font-sans focus:text-sm focus:font-medium focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
