---
import { Image } from "astro:assets";
import agendaPublica from "../assets/screenshots/09-agenda-reserva.png";
import consultasHistorial from "../assets/screenshots/03-consultas-historial.png";
import seguridad from "../assets/screenshots/07-seguridad.png";
import pagos from "../assets/screenshots/06-pagos.png";

// Grouped the way the section headline promises: clinical, legal, administrative.
const groups = [
  {
    name: "Lo clínico",
    lead: "La ficha y su historia, tal como las dejaste.",
    frames: [
      {
        src: consultasHistorial,
        alt: "Historial de consultas de una paciente: una consulta corregida con su etiqueta de corrección y, debajo, el historial con la versión original intacta",
        start: 0.47,
        tab: "Historial de consultas",
        kicker: "Cada consulta, con su historia",
        label: "Una consulta corregida conserva su versión original, a la vista. Datos de ejemplo.",
      },
    ],
    items: [
      {
        title: "Nada se pierde al corregir",
        body: "Si te equivocas o necesitas ajustar una consulta, se guarda como una versión nueva. La original queda intacta y disponible, nunca se sobrescribe.",
      },
      {
        title: "Tu ficha, en PDF, cuando la necesites",
        body: "Exporta la ficha clínica completa de un paciente en PDF cuando quieras, sin pedírsela a nadie.",
      },
      {
        title: "Pacientes niños, niñas y adolescentes",
        body: "Registra hasta 2 representantes legales, el consentimiento que otorgan y el asentimiento del niño, niña o adolescente. Los cobros y avisos se dirigen a sus representantes.",
      },
      {
        title: "Informe de alta con firma simple",
        body: "Cierra el tratamiento con un informe en PDF que lleva tu firma simple y un hash SHA-256 para verificar que no fue alterado. Es una firma simple, no una firma electrónica avanzada.",
      },
    ],
  },
  {
    name: "Lo legal y la seguridad",
    lead: "Lo que debe quedar registrado, y quién puede entrar.",
    frames: [
      {
        src: seguridad,
        alt: "Configuración de seguridad con la autenticación de dos factores activa y la conexión a Google Calendar",
        start: 0.21,
        tab: "Seguridad",
        kicker: "Quién puede entrar",
        label: "Doble verificación activa en la cuenta y la conexión opcional a Google Calendar. Datos de ejemplo.",
      },
    ],
    items: [
      {
        title: "Doble verificación al entrar",
        body: "Además de tu contraseña, un código temporal en tu teléfono confirma que eres tú. Es obligatorio para toda cuenta.",
      },
      {
        title: "Recuperación sin depender de soporte",
        body: "Si olvidas tu contraseña o pierdes tu dispositivo de verificación, recuperas el acceso tú mismo con tus códigos de recuperación de un solo uso.",
      },
      {
        title: "Consentimiento que queda escrito",
        body: "Cada vez que un paciente autoriza o retira su consentimiento (para tratamiento, para telemedicina), Umbral lo anota y lo conserva. Ese historial se conserva junto a la ficha y no se pierde por error.",
      },
      {
        title: "Documentos protegidos",
        body: "Sube PDF, Word, Excel, ZIP e imágenes de cada paciente (hasta 25 MB) y se cifran antes de almacenarse. Los textos clínicos de tus consultas e informes de alta también se guardan cifrados.",
      },
      {
        title: "Registro de quién hizo qué",
        body: "Umbral mantiene un registro de auditoría que no se puede modificar ni borrar.",
      },
    ],
  },
  {
    name: "Lo administrativo",
    lead: "La agenda, los avisos y el cobro, sin planillas.",
    frames: [
      {
        src: agendaPublica,
        alt: "Agenda pública de una terapeuta con su perfil, un calendario con los días disponibles, el horario elegido y el formulario con los datos del paciente para confirmar la reserva",
        start: 0.31,
        tab: "Agenda pública",
        kicker: "Lo que ve tu paciente",
        label: "Tu paciente elige un horario libre y reserva con sus datos, sin crear una cuenta. Datos de ejemplo.",
      },
      {
        src: pagos,
        composite: true,
        alt: "Composición con la cuenta de pagos Flow conectada, que indica que Umbral nunca custodia el dinero, junto a tres consultas con su estado de cobro: dos pagadas y una con cobro pendiente",
        tab: "Cobro de las sesiones",
        kicker: "Cobro por sesión",
        label:
          "Composición de dos pantallas: tu cuenta Flow conectada y el estado de cobro de cada sesión, que en la aplicación viven por separado. Datos de ejemplo.",
      },
    ],
    items: [
      {
        title: "Agenda pública con tu propio enlace",
        body: "Tus pacientes ven tus horarios libres y reservan sin crear cuenta, según tu horario semanal, tus bloqueos y los feriados de Chile. Con 24 horas de anticipación mínima y hasta 60 días hacia adelante.",
      },
      {
        title: "Avisos 24 y 2 horas antes de cada sesión",
        body: "Un aviso por correo y una notificación dentro de Umbral antes de cada sesión, con un centro de notificaciones para todos los avisos de tu práctica.",
      },
      {
        title: "Se agenda solo en tu Google Calendar",
        body: "Conecta tu cuenta y cada sesión aparece sola en tu calendario, con las iniciales del paciente y una descripción genérica, nunca su nombre completo, RUT ni datos clínicos. Las sesiones solo van de Umbral hacia tu calendario, nunca al revés.",
      },
      {
        title: "Cobro en línea con tu cuenta Flow",
        body: "Conecta tu propia cuenta Flow y cada sesión puede generar un enlace de pago enviado por email. El pago va directo a tu cuenta: Umbral no custodia el dinero.",
      },
    ],
  },
];
---

<section id="funcionalidades" class="rule border-t bg-cream-200 px-6 py-20 sm:px-10 sm:py-28 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl">
    <p class="marker">§ 03 · Funcionalidades</p>
    <h2
      class="mt-5 max-w-3xl font-display text-4xl leading-[1.08] tracking-tight text-slate-950 sm:text-5xl dark:text-cream-50"
    >
      Lo clínico, lo legal y lo administrativo, en un solo lugar.
    </h2>

    <div class="mt-16 space-y-16">
      {
        groups.map((group) => (
          <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-4">
              <h3 class="font-display text-2xl text-slate-950 dark:text-cream-50">{group.name}</h3>
              <p class="mt-2 max-w-xs font-sans text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                {group.lead}
              </p>
            </div>
            <div class="min-w-0 lg:col-span-8">
              <dl class="grid gap-x-10 sm:grid-cols-2">
                {group.items.map((item) => (
                  <div class="rule border-t py-6">
                    <dt class="font-display text-lg leading-snug text-slate-950 dark:text-cream-50">{item.title}</dt>
                    <dd class="mt-2 font-sans text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                      {item.body}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
            {group.frames?.map((frame) => (
              <figure class="min-w-0 lg:col-span-12">
                <div class="paper overflow-hidden p-0">
                  {!frame.composite && (
                    <div
                      aria-hidden="true"
                      class="flex items-center gap-4 border-b border-slate-900/15 bg-cream-100 px-4 py-3 dark:border-slate-900/15 dark:bg-cream-200"
                    >
                      <span class="flex gap-1.5">
                        <span class="size-2.5 rounded-full bg-slate-900/20" />
                        <span class="size-2.5 rounded-full bg-slate-900/20" />
                        <span class="size-2.5 rounded-full bg-slate-900/20" />
                      </span>
                      <span class="rounded-full bg-cream-50 px-4 py-1 font-sans text-xs text-slate-600">
                        {frame.tab}
                      </span>
                    </div>
                  )}
                  <div data-scroller data-start={frame.start ?? 0} class="group relative">
                    <div
                      tabindex="0"
                      role="group"
                      aria-label={`Captura: ${frame.tab}. Se desplaza en pantallas angostas`}
                      class="overflow-x-auto"
                    >
                      <Image
                        src={frame.src}
                        alt={frame.alt}
                        widths={[800, 1200, 1600, 2000]}
                        sizes="(min-width: 1152px) 1104px, (min-width: 640px) 100vw, 720px"
                        loading="lazy"
                        class="block w-full min-w-[720px]"
                      />
                    </div>
                    <div
                      aria-hidden="true"
                      class="pointer-events-none absolute inset-y-0 right-0 w-14 bg-linear-to-l from-slate-900/20 to-transparent opacity-0 transition-opacity duration-200 group-data-[more=true]:opacity-100"
                    />
                  </div>
                </div>
                <figcaption class="mt-6 flex flex-wrap items-baseline gap-x-4 gap-y-1 font-sans text-sm text-slate-700 dark:text-slate-300">
                  <span class="marker">{frame.kicker}</span>
                  <span>{frame.label}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  // On narrow screens the frames scroll sideways: start on the content the caption talks about
  // (not the app's sidebar) and show a fade on the right edge while there is more to see.
  // It also serves the carousel in ProductShowcase: a hidden tab panel is placed the first time it gets a size.
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("[data-scroller]").forEach((box) => {
      const area = box.firstElementChild;
      let placed = false;
      const sync = () => {
        const max = area.scrollWidth - area.clientWidth;
        box.dataset.more = String(max > 2 && area.scrollLeft < max - 2);
      };
      const place = () => {
        if (!area.clientWidth) return;
        const max = area.scrollWidth - area.clientWidth;
        if (!placed && max > 120) area.scrollLeft = Math.min(max, Number(box.dataset.start) * area.scrollWidth);
        placed = true;
        sync();
      };
      area.addEventListener("scroll", sync, { passive: true });
      new ResizeObserver(place).observe(area);
    });
  });
</script>
