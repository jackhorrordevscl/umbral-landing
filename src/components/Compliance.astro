---
// Law by law, where the product answers it. Rows point at the feature by name instead of
// restating it, so each fact lives in exactly one place ("Funcionalidades" or here).
const laws = [
  {
    law: "Ley 20.584",
    scope: "Derechos y deberes de los pacientes · Art. 12",
    body: "Conservación de la ficha por un mínimo de 15 años: no se borra físicamente y tiene respaldos diarios cifrados fuera de la plataforma principal.",
  },
  {
    law: "Ley 19.628",
    scope: "Protección de la vida privada",
    body: "Resguardo de datos sensibles. Ver «Documentos protegidos» (cifrado AES-256-GCM) y «Doble verificación al entrar» en Funcionalidades.",
  },
  {
    law: "Ley 21.719",
    scope: "Protección de datos personales · a partir del 1 de diciembre de 2026",
    body: "Consentimiento y trazabilidad. Ver «Consentimiento que queda escrito» y «Registro de quién hizo qué» en Funcionalidades.",
  },
];
---

<section id="marco-legal" class="rule border-t bg-cream-100 px-6 py-20 sm:px-10 sm:py-28 dark:bg-slate-950">
  <div class="mx-auto max-w-6xl">
    <p class="marker">§ 04 · Marco legal</p>
    <h2
      class="mt-5 max-w-3xl font-display text-4xl leading-[1.08] tracking-tight text-slate-950 sm:text-5xl dark:text-cream-50"
    >
      Pensado para alinearse con tres leyes chilenas.
    </h2>

    <ul class="rule mt-14 border-t">
      {
        laws.map((row) => (
          <li class="rule grid gap-x-10 gap-y-3 border-b py-7 md:grid-cols-[20rem_1fr]">
            <div>
              <p class="font-mono text-lg text-sage-700 dark:text-sage-300">{row.law}</p>
              <p class="mt-1 max-w-xs font-sans text-sm leading-relaxed text-slate-700 dark:text-slate-300">
                {row.scope}
              </p>
            </div>
            <p class="font-display text-xl leading-snug text-slate-950 dark:text-cream-50">{row.body}</p>
          </li>
        ))
      }
    </ul>

    <p class="mt-8 max-w-2xl font-sans text-sm leading-relaxed text-slate-700 dark:text-slate-300">
      Esto describe lo que Umbral hace, no certifica nada: no es una certificación ni una validación legal.
    </p>
  </div>
</section>
