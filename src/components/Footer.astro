---
import { WHATSAPP_DISPLAY, whatsappHref } from "../support";

const year = new Date().getFullYear();

const legal = [
  { href: "/privacidad-general/", label: "Política de privacidad" },
  { href: "/terminos/", label: "Términos de servicio" },
  { href: "/privacidad-google-calendar/", label: "Privacidad de Google Calendar" },
];
---

<footer class="rule border-t bg-cream-200 px-6 py-12 sm:px-10 dark:bg-slate-950">
  <div class="mx-auto grid max-w-6xl gap-10 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <a href="/" class="-ml-1 inline-flex py-2 text-slate-900 dark:text-cream-50" aria-label="Umbral, inicio">
        <span class="logo-mark" role="img" aria-hidden="true"></span>
      </a>
      <p class="mt-4 max-w-xs font-sans text-sm leading-relaxed text-slate-700 dark:text-slate-300">
        La ficha clínica para terapeutas que atienden por su cuenta.
      </p>
      <p class="mt-2 font-sans text-sm text-slate-700 dark:text-slate-300">
        Soporte directo por WhatsApp:
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block py-3 underline decoration-slate-500 underline-offset-4 hover:text-slate-950 dark:hover:text-cream-50"
          >{WHATSAPP_DISPLAY}</a
        >
      </p>
    </div>

    <nav aria-label="Legal y marco normativo" class="lg:col-span-7">
      <ul
        class="flex flex-col font-sans text-sm text-slate-700 sm:flex-row sm:flex-wrap sm:gap-x-8 lg:justify-end dark:text-slate-300"
      >
        <li>
          <a
            href="/#marco-legal"
            class="inline-block py-3 underline decoration-slate-500 underline-offset-4 hover:text-slate-950 dark:hover:text-cream-50"
            >Marco legal</a
          >
        </li>
        {
          legal.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block py-3 underline decoration-slate-500 underline-offset-4 hover:text-slate-950 dark:hover:text-cream-50"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div
    class="rule mx-auto mt-10 flex max-w-6xl flex-col justify-between gap-2 border-t pt-6 font-sans text-xs text-slate-700 sm:flex-row dark:text-slate-300"
  >
    <p>Umbral © <span id="footer-year">{year}</span>. Todos los derechos reservados.</p>
    <p>Desarrollado por Ground Zero Devs</p>
  </div>
</footer>

<script is:inline>
  // the build year goes stale until the next deploy; the visitor's clock does not
  document.getElementById("footer-year").textContent = String(new Date().getFullYear());
</script>
