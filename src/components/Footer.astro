---
const year = new Date().getFullYear();
---

<footer class="border-t border-sage-200 bg-cream-200 px-6 py-10 sm:px-10 dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <a href="#top" class="flex items-center gap-2">
      <span class="brand-gradient flex items-center rounded-lg px-3 py-1.5">
        <img src="/logo.svg" alt="Umbral" width="490" height="247" class="h-6 w-auto" />
      </span>
    </a>
    <p class="font-sans text-xs text-slate-600 dark:text-slate-400">
      Uso privado — Umbral © {year}. Todos los derechos reservados.
    </p>
    <p class="font-mono text-xs uppercase tracking-[0.15em] text-slate-600 dark:text-slate-400">
      Cumple con Ley 20.584 · Ley 19.628 · Ley 21.719
    </p>
  </div>
  <p class="mt-6 text-center font-sans text-xs text-slate-600 dark:text-slate-400">Desarrollado por Ground Zero Devs</p>
</footer>
