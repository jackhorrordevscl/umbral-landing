---
const year = new Date().getFullYear();
---

<footer class="border-t border-sage-200 bg-cream-200 px-6 py-10 sm:px-10 dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-4 text-center sm:flex-row sm:text-left">
    <a href="#top" class="flex items-center gap-2">
      <span class="brand-gradient flex items-center rounded-lg px-3 py-1.5">
        <img src="/logo.svg" alt="Umbral" width="490" height="247" class="h-6 w-auto" />
      </span>
    </a>
    <p class="font-sans text-xs text-slate-600 dark:text-slate-400">
      Umbral © {year}. Todos los derechos reservados.
    </p>
    <a
      href="#cumplimiento"
      class="font-mono text-sm uppercase tracking-[0.15em] text-slate-600 underline decoration-slate-400 underline-offset-4 transition-colors hover:text-slate-900 dark:text-slate-400 dark:decoration-slate-600 dark:hover:text-cream-100"
    >
      Ver cumplimiento legal
    </a>
  </div>
  <p
    class="mt-6 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center font-sans text-xs text-slate-600 dark:text-slate-400"
  >
    <a
      href="/privacidad-general"
      class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900 dark:decoration-slate-600 dark:hover:text-cream-100"
      >Política de privacidad</a
    >
    <span aria-hidden="true">·</span>
    <a
      href="/terminos"
      class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900 dark:decoration-slate-600 dark:hover:text-cream-100"
      >Términos de servicio</a
    >
    <span aria-hidden="true">·</span>
    <a
      href="/privacidad-google-calendar"
      class="underline decoration-slate-400 underline-offset-4 hover:text-slate-900 dark:decoration-slate-600 dark:hover:text-cream-100"
      >Privacidad — Google Calendar</a
    >
  </p>
  <p class="mt-2 text-center font-sans text-xs text-slate-600 dark:text-slate-400">Desarrollado por Ground Zero Devs</p>
</footer>
