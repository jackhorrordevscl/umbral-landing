---
import { Image } from "astro:assets";
import dashboard from "../assets/screenshots/01-dashboard.png";
import pacientes from "../assets/screenshots/02-pacientes-listado.png";
import nuevaFicha from "../assets/screenshots/03-pacientes-nueva-ficha.png";
import consultas from "../assets/screenshots/04-consultas-listado.png";
import calendarioMes from "../assets/screenshots/05-calendario-mes.png";
import calendarioDetalle from "../assets/screenshots/06-calendario-detalle-dia.png";
import repositorio from "../assets/screenshots/07-repositorio.png";
import subirArchivo from "../assets/screenshots/07b-repositorio-subir-archivo.png";
import seguridad from "../assets/screenshots/08-seguridad.png";

const screens = [
  {
    src: dashboard,
    alt: "Dashboard de Umbral con pacientes activos, consultas registradas y consentimientos firmados",
    label: "Dashboard",
  },
  { src: pacientes, alt: "Listado de pacientes con RUT, contacto y estado de consentimiento", label: "Pacientes" },
  { src: nuevaFicha, alt: "Formulario de nueva ficha de paciente", label: "Nueva ficha" },
  {
    src: consultas,
    alt: "Registro de consultas con motivo, intervención y acuerdos por sesión",
    label: "Consultas y sesiones",
  },
  { src: calendarioMes, alt: "Calendario mensual con sesiones agendadas", label: "Calendario" },
  {
    src: calendarioDetalle,
    alt: "Detalle de una sesión agendada en el calendario, con opción de agendar",
    label: "Detalle de sesión",
  },
  {
    src: repositorio,
    alt: "Repositorio de archivos con plantillas, formularios y protocolos",
    label: "Repositorio de archivos",
  },
  { src: subirArchivo, alt: "Modal para subir un archivo al repositorio personal", label: "Subir archivo" },
  { src: seguridad, alt: "Configuración de seguridad con MFA y conexión a Google Calendar", label: "Seguridad" },
];
---

<section
  id="capturas"
  class="relative overflow-hidden border-t border-sage-200 bg-cream-200 px-6 py-20 sm:px-10 dark:border-slate-800 dark:bg-slate-900"
>
  <div class="section-texture" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-3xl text-center">
    <p class="font-sans text-xs font-medium uppercase tracking-[0.3em] text-sage-600 dark:text-sage-400">
      Así se ve por dentro
    </p>
    <h2 class="mt-4 font-display text-4xl leading-tight tracking-tight text-slate-900 sm:text-5xl dark:text-cream-50">
      Nada de maquetas. La aplicación real.
    </h2>
    <p
      class="mx-auto mt-6 max-w-xl text-balance font-sans text-base leading-relaxed text-slate-600 dark:text-slate-400"
    >
      Capturas del sistema en funcionamiento, con datos de ejemplo — así se ve tu día a día llevando fichas en
      Umbral.
    </p>
  </div>

  <div class="relative z-10 mt-14">
    <div
      id="showcase-track"
      class="flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth px-6 pb-6 sm:px-[calc((100%-64rem)/2)]"
      style="scrollbar-width: none;"
    >
      {
        screens.map((screen) => (
          <figure class="w-[85vw] shrink-0 snap-center sm:w-[42rem]">
            <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg dark:border-slate-700 dark:shadow-none">
              <div class="flex items-center gap-1.5 border-b border-slate-100 bg-cream-100 px-3 py-2 dark:border-slate-700 dark:bg-slate-800">
                <span class="h-2.5 w-2.5 rounded-full bg-slate-300 dark:bg-slate-600" />
                <span class="h-2.5 w-2.5 rounded-full bg-slate-300 dark:bg-slate-600" />
                <span class="h-2.5 w-2.5 rounded-full bg-slate-300 dark:bg-slate-600" />
              </div>
              <Image
                src={screen.src}
                alt={screen.alt}
                widths={[672, 1024, 1344]}
                sizes="(min-width: 640px) 42rem, 85vw"
                loading="lazy"
                class="showcase-img w-full"
              />
            </div>
            <figcaption class="mt-3 text-center font-sans text-sm font-medium text-slate-600 dark:text-slate-400">
              {screen.label}
            </figcaption>
          </figure>
        ))
      }
    </div>

    <div class="mt-2 flex items-center justify-center gap-3">
      <button
        id="showcase-prev"
        type="button"
        aria-label="Captura anterior"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition-colors hover:border-sage-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:border-sage-500 dark:hover:text-cream-100"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>
      <button
        id="showcase-next"
        type="button"
        aria-label="Siguiente captura"
        class="flex h-9 w-9 items-center justify-center rounded-lg border border-slate-200 text-slate-600 transition-colors hover:border-sage-400 hover:text-slate-900 dark:border-slate-700 dark:text-slate-400 dark:hover:border-sage-500 dark:hover:text-cream-100"
      >
        <svg
          class="h-4 w-4"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  #showcase-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script is:inline>
  const track = document.getElementById("showcase-track");
  const prevBtn = document.getElementById("showcase-prev");
  const nextBtn = document.getElementById("showcase-next");

  const scrollByCard = (direction) => {
    const card = track.querySelector("figure");
    if (!card) return;
    const gap = 24;
    track.scrollBy({ left: direction * (card.offsetWidth + gap), behavior: "smooth" });
  };

  prevBtn.addEventListener("click", () => scrollByCard(-1));
  nextBtn.addEventListener("click", () => scrollByCard(1));

  // native loading="lazy" only checks vertical viewport intersection, so
  // cards sitting outside the initial horizontal scroll position never load —
  // force them in once the carousel itself is visible.
  const section = track.closest("section");
  if (section && "IntersectionObserver" in window) {
    const revealImages = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          track.querySelectorAll("img.showcase-img").forEach((img) => {
            img.loading = "eager";
          });
          revealImages.disconnect();
        }
      },
      { rootMargin: "200px" },
    );
    revealImages.observe(section);
  }
</script>
