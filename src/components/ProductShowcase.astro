---
import { Image } from "astro:assets";
import dashboard from "../assets/screenshots/01-dashboard.png";
import pacientes from "../assets/screenshots/02-pacientes-listado.png";
import consultasHistorial from "../assets/screenshots/03-consultas-historial.png";
import consultasNueva from "../assets/screenshots/04-consultas-nueva.png";
import calendarioMes from "../assets/screenshots/05-calendario-mes.png";
import pagos from "../assets/screenshots/06-pagos.png";
import seguridad from "../assets/screenshots/07-seguridad.png";

const screens = [
  {
    src: dashboard,
    alt: "Dashboard de Umbral con pacientes activos, consultas registradas, consentimientos firmados y próximas sesiones",
    label: "Dashboard",
  },
  {
    src: pacientes,
    alt: "Listado de pacientes con búsqueda por nombre o RUT, contacto y estado de consentimiento",
    label: "Pacientes",
  },
  {
    src: consultasHistorial,
    alt: "Historial de consultas de un paciente con motivo, intervención y acuerdos de cada sesión",
    label: "Historial de consultas",
  },
  {
    src: consultasNueva,
    alt: "Formulario para registrar una sesión, con editor de texto enriquecido para motivo, intervención y acuerdos",
    label: "Registrar una sesión",
  },
  { src: calendarioMes, alt: "Calendario mensual con las sesiones agendadas de cada día", label: "Calendario" },
  {
    src: pagos,
    alt: "Pantalla de pagos para conectar tu cuenta de Flow y cobrar las sesiones en línea",
    label: "Pagos con Flow",
  },
  {
    src: seguridad,
    alt: "Configuración de seguridad con autenticación de dos factores activa y conexión opcional a Google Calendar",
    label: "Seguridad",
  },
];
---

<section id="capturas" class="bg-slate-950 px-6 py-20 text-cream-100 sm:px-10 sm:py-28 dark:bg-slate-900">
  <div class="mx-auto grid max-w-6xl gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="min-w-0 lg:col-span-4">
      <p class="marker text-sage-300!">§ 02 · Por dentro</p>
      <h2 class="mt-5 font-display text-4xl leading-[1.08] tracking-tight text-cream-50 sm:text-5xl">
        La aplicación real, con datos de ejemplo.
      </h2>
      <p class="mt-6 max-w-sm font-sans text-base leading-relaxed text-slate-300">
        Capturas del sistema en funcionamiento. Elige una pantalla para verla completa.
      </p>

      <div
        role="tablist"
        aria-label="Pantallas de Umbral"
        hidden
        id="shot-tablist"
        class="-mx-1.5 mt-[2.125rem] flex gap-2 overflow-x-auto p-1.5 lg:flex-col lg:gap-0 lg:overflow-visible lg:pb-0"
      >
        {
          screens.map((screen, i) => (
            <button
              type="button"
              role="tab"
              id={`shot-tab-${i}`}
              aria-controls={`shot-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              class="shot-tab flex shrink-0 items-baseline gap-3 rounded-lg border border-slate-700 px-4 py-3 text-left font-sans text-sm text-slate-300 transition-colors hover:text-cream-50 aria-selected:border-sage-300 aria-selected:text-cream-50 lg:rounded-none lg:border-0 lg:border-l-2 lg:border-l-slate-700 lg:py-3 lg:pl-5 lg:aria-selected:border-l-sage-300"
            >
              <span class="font-mono text-[0.8125rem] text-slate-400">{String(i + 1).padStart(2, "0")}</span>
              <span>{screen.label}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="min-w-0 lg:col-span-8">
      {
        screens.map((screen, i) => (
          <div id={`shot-panel-${i}`} data-tab={`shot-tab-${i}`} class="shot-panel">
            <figure>
              <div class="paper overflow-hidden p-0">
                <Image
                  src={screen.src}
                  alt={screen.alt}
                  widths={[800, 1200, 1600]}
                  sizes="(min-width: 1024px) 60vw, 100vw"
                  loading={i === 0 ? "eager" : "lazy"}
                  class="block w-full"
                />
              </div>
              <figcaption class="mt-4 font-sans text-sm text-slate-300">
                {String(i + 1).padStart(2, "0")} · {screen.label}. Datos de ejemplo.
              </figcaption>
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  // without JavaScript every capture is shown stacked; with it, they become tabs
  const tablist = document.getElementById("shot-tablist");
  const tabs = Array.from(document.querySelectorAll(".shot-tab"));
  const panels = Array.from(document.querySelectorAll(".shot-panel"));

  const select = (index, moveFocus) => {
    tabs.forEach((tab, i) => {
      const active = i === index;
      tab.setAttribute("aria-selected", String(active));
      tab.tabIndex = active ? 0 : -1;
      panels[i].hidden = !active;
    });
    if (moveFocus) tabs[index].focus();
  };

  // tab semantics are applied here, so without JavaScript the panels are plain stacked figures
  panels.forEach((panel) => {
    panel.setAttribute("role", "tabpanel");
    panel.setAttribute("aria-labelledby", panel.dataset.tab);
  });
  const wide = window.matchMedia("(min-width: 1024px)");
  const syncOrientation = () => tablist.setAttribute("aria-orientation", wide.matches ? "vertical" : "horizontal");
  syncOrientation();
  wide.addEventListener("change", syncOrientation);
  tablist.hidden = false;
  select(0, false);

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(i, false));
    tab.addEventListener("keydown", (event) => {
      const last = tabs.length - 1;
      const keys = {
        ArrowRight: i === last ? 0 : i + 1,
        ArrowDown: i === last ? 0 : i + 1,
        ArrowLeft: i === 0 ? last : i - 1,
        ArrowUp: i === 0 ? last : i - 1,
        Home: 0,
        End: last,
      };
      if (!(event.key in keys)) return;
      event.preventDefault();
      select(keys[event.key], true);
    });
  });
</script>
