---
import ThemeToggle from "./ThemeToggle.astro";
---

<header
  class="sticky inset-x-0 top-0 z-20 flex items-center justify-between border-b border-sage-200 bg-cream-100/90 px-6 py-4 backdrop-blur sm:px-10 dark:border-slate-800 dark:bg-slate-950/90"
>
  <a href="#top" class="flex items-center gap-2">
    <span class="brand-gradient flex items-center rounded-lg px-3 py-1.5">
      <img src="/logo.svg" alt="Umbral" class="h-6 w-auto" />
    </span>
  </a>

  <nav class="hidden items-center gap-8 font-sans text-sm text-slate-600 md:flex dark:text-slate-400">
    <a href="#funcionalidades" class="transition-colors hover:text-slate-900 dark:hover:text-cream-100"
      >Funcionalidades</a
    >
    <a href="#cumplimiento" class="transition-colors hover:text-slate-900 dark:hover:text-cream-100"
      >Cumplimiento legal</a
    >
    <a href="#acceso" class="transition-colors hover:text-slate-900 dark:hover:text-cream-100">Manual de uso</a>
  </nav>

  <div class="flex items-center gap-3">
    <ThemeToggle />
    <a
      href="#acceso"
      class="rounded-lg bg-sage-600 px-4 py-2 font-sans text-sm font-medium text-white transition-colors duration-200 hover:bg-sage-700"
    >
      Solicitar acceso
    </a>
  </div>
</header>
