---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Página no encontrada | Umbral" description="La página que buscas no existe en Umbral." noindex>
  <Header />
  <main id="main-content" class="mx-auto max-w-6xl px-6 py-28 sm:px-10">
    <p class="marker">Error 404</p>
    <h1 class="mt-5 max-w-2xl font-display text-5xl leading-[1.05] tracking-tight text-slate-950 dark:text-cream-50">
      Esta página no está en la ficha.
    </h1>
    <p class="mt-6 max-w-lg font-sans text-lg leading-relaxed text-slate-700 dark:text-slate-300">
      El enlace puede estar mal escrito o la página ya no existe.
    </p>
    <a
      href="/"
      class="mt-10 inline-block rounded-lg bg-sage-600 px-6 py-3.5 font-sans text-sm font-medium text-white transition-colors duration-200 hover:bg-sage-700"
    >
      Volver al inicio
    </a>
  </main>
  <Footer />
</Layout>
